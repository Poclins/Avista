# jAImes - configuración local (AWS no es necesario)
APP_NAME=jAImes
ENVIRONMENT=development
DEBUG=true

# Base relacional local
DATABASE_URL=sqlite:///./jaimes_local.db
DATASET_ZIP_PATH=./dataset_e1_publico.zip
LOCAL_STORAGE_DIR=./storage

# Solo para un despliegue posterior en producción
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
TITAN_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0