# jAImes — variables de entorno (copiar a .env y ajustar)
# -----------------------------------------------------------------------------

# --- Aplicación ---
APP_NAME=jAImes
ENVIRONMENT=development
DEBUG=true

# --- Modo demo ---
# true  -> corre sin AWS: providers/storage mock + repos locales (demo).
# false -> usa servicios AWS reales a través de las mismas interfaces.
USE_MOCKS=true

# --- Base de datos relacional ---
# Demo (mock): SQLite local.
DATABASE_URL=sqlite:///./jaimes.db
# AWS / docker-compose (Postgres + pgvector), ejemplo:
# DATABASE_URL=postgresql+psycopg://jaimes:jaimes@db:5432/jaimes

# --- Almacenamiento de objetos ---
S3_BUCKET=jaimes-media
LOCAL_STORAGE_DIR=./storage

# --- AWS (solo necesario con USE_MOCKS=false) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
TITAN_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
